[Unit]
Description=Verify and install a trusted Svoi GitHub release
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=root
Group=root
ExecStart=/usr/bin/python3 -Es /usr/local/lib/svoi/update.py
TimeoutStartSec=10min
UMask=0077
RuntimeDirectory=svoi-autodeploy
RuntimeDirectoryMode=0700
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
ReadWritePaths=/opt/svoi /var/lib/svoi-deploy
MemoryMax=256M
TasksMax=32
