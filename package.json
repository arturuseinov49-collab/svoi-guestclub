{
  "name": "svoi-telegram",
  "version": "0.2.0",
  "main": "index.ts",
  "dependencies": {
    "@expo-google-fonts/manrope": "^0.4.3",
    "@expo/vector-icons": "^15.0.2",
    "@react-native-async-storage/async-storage": "2.2.0",
    "expo": "~58.0.23",
    "expo-file-system": "~58.0.13",
    "expo-font": "~58.0.11",
    "expo-sharing": "~58.0.22",
    "expo-status-bar": "~58.0.4",
    "qrcode": "^1.5.4",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.1",
    "react-native-safe-area-context": "~5.11.1",
    "react-native-web": "^0.21.4"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "@types/qrcode": "^1.5.6",
    "@types/react": "~19.3.0",
    "eslint": "^9.39.5",
    "eslint-config-expo": "~58.0.4",
    "jsqr": "^1.4.0",
    "sharp": "^0.35.5",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env.local server/index.mjs",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "test": "node tools/build-server.mjs && tsx --test tests/domain.test.ts tests/pos.test.ts tests/telegram.test.ts tests/pending.test.ts tests/qr.test.ts && node --test tests/server*.mjs",
    "build:server": "node tools/build-server.mjs",
    "test:ui": "playwright test --config playwright-live.config.ts",
    "build": "node tools/build-miniapp.mjs",
    "bot": "node --env-file-if-exists=.env.local bot/index.mjs",
    "dev": "expo start --web",
    "lint": "eslint App.tsx src"
  },
  "private": true,
  "overrides": {
    "glob": "14.0.4",
    "minimatch": "11.0.5"
  }
}
