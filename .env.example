# Keep the real token in an untracked .env.local file. Never commit or share it.
TELEGRAM_BOT_TOKEN=
EXPECTED_BOT_USERNAME=svoi_guestclub_demo_bot
# Platform developers: explicit verified Telegram numeric IDs, comma-separated.
# Empty means nobody can create venues or appoint managers. Never use usernames here.
DEVELOPER_TELEGRAM_IDS=
# Published public HTTPS Mini App URL; a private preview URL cannot be used by guests.
PUBLIC_APP_URL=
PORT=8081
HOST=127.0.0.1
# Persistent SQLite database; keep this directory outside the deployed release.
# Production: /var/lib/svoi/svoi.sqlite
DATABASE_PATH=./data/svoi.sqlite
# 32 random bytes encoded as base64. Keep outside SQLite/backups; required to save POS keys.
# Generate once on the deployment host. Losing this key requires reconnecting all POS accounts.
POS_MASTER_KEY=
